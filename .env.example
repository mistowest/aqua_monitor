APP_NAME=Aqua Monitor
DATABASE_URL=sqlite:///./monitor.db
SESSION_SECRET=troque-por-uma-chave-grande-e-aleatoria
SESSION_MAX_AGE=604800
SESSION_HTTPS_ONLY=false
DEVICE_OFFLINE_SECONDS=30

# Backend MQTT: somente leitura via ACL
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=aqua-monitor-backend
MQTT_TELEMETRY_TOPIC=aqua-monitor/devices/+/telemetry
MQTT_STATUS_TOPIC=aqua-monitor/devices/+/status
MQTT_QOS=1
MQTT_KEEPALIVE=60
MQTT_USERNAME=aqua-backend
MQTT_PASSWORD=change-backend-password
MQTT_TLS=false

# Simulador: representa um ESP32 e só publica nos próprios tópicos
MQTT_SIM_DEVICE_ID=esp32-01
MQTT_SIM_USERNAME=esp32-01
MQTT_SIM_PASSWORD=change-device-password
MQTT_SIM_INTERVAL=5